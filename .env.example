# Vercel: set NODE_ENV=production, CORS_ORIGINS, APP_PUBLIC_URL, DATABASE_URL, and all secrets
# in Project → Settings → Environment Variables. Build uses `npm run vercel-build` (Prisma + tsc).
# For Postgres from serverless, use a pooler (Neon, Supabase pooler, Prisma Accelerate) and/or
# `?connection_limit=1` to avoid exhausting connections.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/believechops?schema=public"

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Dashboard → Settings → Webhooks: https://<public-api-host>/api/webhooks/paystack
# (HMAC uses the same secret as PAYSTACK_SECRET_KEY.) Local dev: use ngrok/cloudflared to expose PORT, then paste that URL + path.
# Optional dev-only: Bearer token for POST /api/dev/simulate-paystack-paid { "reference": "..." } when webhooks cannot reach localhost.
# WEBHOOK_SIMULATE_SECRET=at_least_sixteen_random_chars

CORS_ORIGINS=http://localhost:5173

# Auth — use long random values in production
JWT_SECRET=replace_with_at_least_32_random_characters_hex_or_base64
JWT_EXPIRES_IN=7d

OTP_PEPPER=replace_with_at_least_16_random_characters
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# Used when request body omits `channel`: `email` | `sms`
OTP_DEFAULT_CHANNEL=email

# Email OTP — set provider and SMTP to send real mail (omit for dev console fallback)
NOTIFICATION_EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# SMS OTP — Arkesel SMS V2: POST /api/v2/sms/send only (`api-key` header). Use `none` for dev (OTP logged).
NOTIFICATION_SMS_PROVIDER=none
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
# ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
# ARKESEL_SANDBOX=true

# Optional legacy Twilio instead of Arkesel
# NOTIFICATION_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Scheduling service (Quartz) — e.g. create jobs: POST {SCHEDULING_ENGINE_URL}/api/jobs
# SCHEDULING_ENGINE_URL=https://schedulingengine.onrender.com

# Public URL of this API (e.g. ngrok). SchedulingEngine callbackUrl: {APP_PUBLIC_URL}/api/…
# APP_PUBLIC_URL=https://xxxx.ngrok-free.app

# Optional: web app origin for “Browse menu” links in welcome emails (else first CORS origin + /menu)
# FRONTEND_PUBLIC_URL=http://localhost:5173

# Menu-reminder callback from SchedulingEngine: embedded as ?secret= on callbackUrl (min 16 chars). No bearer token on dispatch.
# SCHEDULER_DISPATCH_SECRET=generate_a_long_random_string_here
